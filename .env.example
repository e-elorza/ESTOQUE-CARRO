# Copy to .env.local for local development. Never commit real values.
# Without these, the site runs on the built-in demo data (src/lib/data/seed.ts).

NEXT_PUBLIC_SUPABASE_URL=
# "anon" or "publishable" key: safe for the browser, limited by Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" or "secret" key: server only. Used to store leads and process photos.
SUPABASE_SERVICE_ROLE_KEY=
