# Copy to .env.local for local development. Never commit real values.
# Without DATABASE_URL the public site runs on built-in demo data and the admin is disabled.

# PostgreSQL connection (Supabase: use the "Transaction pooler" string, port 6543)
DATABASE_URL=
# Optional: max connections per server instance (default 5)
DATABASE_POOL_MAX=

# Photo storage, any S3-compatible bucket (Supabase Storage, Cloudflare R2, AWS S3).
# Leave empty to store photos on local disk in ./storage (development or a VPS with backups only).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL where uploaded objects can be read
S3_PUBLIC_URL=
